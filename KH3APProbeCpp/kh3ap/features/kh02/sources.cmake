# Canonical roots for shared protocol and generated metadata includes.
# Do not add feature subdirectories: bare cross-module imports must fail.
target_include_directories(${TARGET} PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}/.."
    "${KH3AP_NATIVE_ROOT}/include"
)

# KH0.2 file adapter requires the matching licensed UE4.17 interface headers.
set(KH3AP_UE417_CORE_ROOT "$ENV{KH3AP_UE417_CORE_ROOT}" CACHE PATH
    "Licensed UE4.17 Engine/Source/Runtime/Core directory for the KH0.2 file adapter")
foreach(_kh02_core_header IN ITEMS Templates/Function.h HAL/UnrealMemory.h Containers/Map.h)
    if(NOT EXISTS "${KH3AP_UE417_CORE_ROOT}/Public/${_kh02_core_header}")
        message(FATAL_ERROR
            "KH0.2 requires matching licensed UE4.17 Core headers. Set KH3AP_UE417_CORE_ROOT "
            "to Engine/Source/Runtime/Core via CMake -D or the environment before configuring.")
    endif()
endforeach()
set_source_files_properties("${CMAKE_CURRENT_LIST_DIR}/transport/kh02_remote_abi.cpp" PROPERTIES
        INCLUDE_DIRECTORIES "${KH3AP_UE417_CORE_ROOT}/Public;${KH3AP_UE417_CORE_ROOT}/Public/Windows;${KH3AP_UE417_CORE_ROOT}/Public/Containers;${KH3AP_UE417_CORE_ROOT}/Public/Templates"
        COMPILE_OPTIONS "/permissive;/Zc:preprocessor-"
        COMPILE_DEFINITIONS "CORE_API=;IS_MONOLITHIC=1;IS_PROGRAM=0;UE_BUILD_MINIMAL=1;WITH_PLUGIN_SUPPORT=0;WITH_SERVER_CODE=1;WITH_ENGINE=0;WITH_EDITOR=0;WITH_EDITORONLY_DATA=0;STATS=0;USE_LOGGING_IN_SHIPPING=0;WITH_UNREAL_DEVELOPER_TOOLS=0")


