if(NOT DEFINED DLL_FILE OR NOT EXISTS "${DLL_FILE}")
    message(FATAL_ERROR "Built probe DLL is required for build metadata")
endif()
if(PERFORMANCE_DIAGNOSTICS)
    set(_diagnostics true)
else()
    set(_diagnostics false)
endif()
file(SHA256 "${DLL_FILE}" _dll_hash)
if(NOT DEFINED RUNTIME_INPUTS_FILE OR NOT EXISTS "${RUNTIME_INPUTS_FILE}")
    message(FATAL_ERROR "Native runtime-data contract is required for build metadata")
endif()
file(SHA256 "${RUNTIME_INPUTS_FILE}" _inputs_hash)
if(NOT DEFINED PROVENANCE_FILE OR NOT EXISTS "${PROVENANCE_FILE}")
    message(FATAL_ERROR "Verified UE4SS provenance is required for build metadata")
endif()
file(READ "${PROVENANCE_FILE}" _info)
# Preserve JSON boolean types instead of CMake's ON/OFF spellings.
string(JSON _info SET "${_info}" schema 3)
string(JSON _info SET "${_info}" first_party_license "\"MIT\"")
string(JSON _info SET "${_info}" runtime_inputs_sha256 "\"${_inputs_hash}\"")
string(JSON _info SET "${_info}" sha256 "\"${_dll_hash}\"")
string(JSON _info SET "${_info}" performance_diagnostics ${_diagnostics})
string(JSON _info SET "${_info}" automation_handlers ${_diagnostics})
file(WRITE "${DLL_FILE}.build.json" "${_info}\n")
