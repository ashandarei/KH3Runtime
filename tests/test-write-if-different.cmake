# Run from the project root with cmake -P tests/test-write-if-different.cmake.
cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/write-if-different.cmake")
set(_test_dir "${CMAKE_CURRENT_LIST_DIR}/../build-write-if-different-test")
set(_output "${_test_dir}/generated.cpp")
set(_content "// Preserve literal C++ text\nint values[] = {1, 2};\n")
kh3ap_write_if_different("${_output}" "${_content}")
file(READ "${_output}" _actual)
if(NOT "${_actual}" STREQUAL "${_content}")
    message(FATAL_ERROR "Generated contents differ")
endif()
file(TIMESTAMP "${_output}" _before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
kh3ap_write_if_different("${_output}" "${_content}")
file(TIMESTAMP "${_output}" _after "%s")
if(NOT _before STREQUAL _after)
    message(FATAL_ERROR "Identical contents changed the timestamp")
endif()
kh3ap_write_if_different("${_output}" "${_content}// changed\n")
file(READ "${_output}" _changed)
file(TIMESTAMP "${_output}" _changed_time "%s")
if(NOT "${_changed}" STREQUAL "${_content}// changed\n" OR _changed_time STREQUAL _before)
    message(FATAL_ERROR "Changed contents were not written")
endif()
message(STATUS "PASS: generated contents, stable timestamps, changed-content invalidation")
