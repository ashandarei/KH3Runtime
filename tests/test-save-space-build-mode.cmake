# Check the actual build branches without requiring engine headers in unit tests.
# The full player build separately compiles this translation unit with its headers.
file(READ "${SOURCE}" source_text)
string(REGEX REPLACE "#include[^\n]*" "" source_text "${source_text}")
file(WRITE "${OUTPUT}" "${source_text}")
if(MSVC)
    set(options /nologo /EP /TP /DKH3AP_ENABLE_PERFORMANCE_DIAGNOSTICS=${MODE})
else()
    set(options -E -P -x c++ -DKH3AP_ENABLE_PERFORMANCE_DIAGNOSTICS=${MODE})
endif()

# The 0.2 story hero and its readiness checks also drive ordinary map UI.
file(READ "${MAP_SOURCE}" source_text)
string(REGEX REPLACE "#include[^\n]*" "" source_text "${source_text}")
file(WRITE "${OUTPUT}.maps.cpp" "${source_text}")
execute_process(COMMAND "${COMPILER}" ${options} "${OUTPUT}.maps.cpp"
    RESULT_VARIABLE result OUTPUT_VARIABLE preprocessed ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Map menu preprocessing failed: ${errors}")
endif()
string(REGEX MATCHALL "Kh02Story::map_overlay_hero\\(\\)" heroes "${preprocessed}")
list(LENGTH heroes hero_count)
string(FIND "${preprocessed}" "Kh02Story::map_overlay_ready(hero)" readiness)
if(NOT hero_count EQUAL 3 OR readiness EQUAL -1)
    message(FATAL_ERROR "0.2 minimap/overlay callbacks missing in mode ${MODE}")
endif()
execute_process(COMMAND "${COMPILER}" ${options} "${OUTPUT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE preprocessed ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Save menu preprocessing failed: ${errors}")
endif()
foreach(required IN ITEMS "Kh02Story::challenges_available()" "Kh02Story::open_area_select("
        "Kh02Story::travel_to_visited_area(" "RuntimeSpaceService::return_from_closed_menu(")
    string(FIND "${preprocessed}" "${required}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Player save-menu behavior missing in mode ${MODE}: ${required}")
    endif()
endforeach()
string(FIND "${preprocessed}" "runtime_save_space_request.json" automation)
if(MODE EQUAL 0 AND NOT automation EQUAL -1)
    message(FATAL_ERROR "Player build contains save-menu automation polling")
elseif(MODE EQUAL 1 AND automation EQUAL -1)
    message(FATAL_ERROR "Diagnostic build is missing save-menu automation")
endif()
